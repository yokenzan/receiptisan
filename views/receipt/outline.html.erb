<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="receiptisan-version" content="<%= lib_version %>">
    <% if digitalized_receipts.length == 1 %>
        <% digitalized_receipt = digitalized_receipts.first%>
        <% seikyuu_ym          = digitalized_receipt.seikyuu_ym.wareki %>
        <title>レセプトプレビュー | <%= digitalized_receipt.audit_payer.short_name %><%= seikyuu_ym.gengou.alphabet %><%= seikyuu_ym.year %>.<%= seikyuu_ym.month %> | <%= digitalized_receipt.hospital.name %></title>
    <% else %>
        <title>レセプトプレビュー</title>
    <% end %>
</head>
<body>
    <div id="receipts">
        <% @svg_of_receipts.each do | pages_of_receipt | %>
            <%# TODO: 空のページが含まれている場合があるので暫定的に省いている %>
            <% pages_of_receipt.reject!(&:empty?) %>

            <div class="receipt"><%# レセプト1件 %>
                <div class="side-by-side"><%# 見開き2ページ %>
                    <%# ページ番号 %>
                    <% page_number = 1 %>

                    <%# 表紙 %>
                    <div class="receipt-page-front sheet">
                        <%= pages_of_receipt.shift %>
                    </div><%# sheet %>

                    <% if pages_of_receipt.empty? %>
                        </div><%# side-by-side %>
                        </div><%# receipt %>
                        <% next %><%# 次のレセプトへ %>
                    <% end %>

                    <%# 続紙 %>
                    <% while (current_page = pages_of_receipt.shift) %>
                        <% page_number += 1 %>
                        <% if page_number.odd? %><div class="side-by-side"><% end %>

                        <div class="receipt-page-next sheet">
                            <%= current_page %>
                        </div><%# sheet %>

                        <% if page_number.even? %></div><% end %><%# side-by-side %>
                    <% end %>

                    <% if page_number.odd? %></div><% end %><%# side-by-side %>
            </div><%# receipt %>
        <% end %>
    </div><%# receipts %>
    <style>
    @media screen {
        /* https://qiita.com/cognitom/items/d39d5f19054c8c8fd592 */
        body {
            background: #ccc;
        }
    }
    .sheet {
        display: inline-block;
        page-break-after: always;
    }
    <%# SVGテンプレートから inline style を除去した代わりに、ここで中央寄せを指定 %>
    .sheet svg {
        display: block;
        margin-left: auto;
        margin-right: auto;
    }
    <%# font-family は全 text 要素で共通のため、各クラスでの個別指定を廃しここに一元化 %>
    text {
        white-space: pre;
        font-family: Mincho, serif;
    }
    path, image { pointer-events: none; }

    .weight-bold { font-weight: bold; }
    <%# text-anchor="end" 属性の CSS クラス化。テンプレート中のインライン属性の繰り返しを削減する %>
    .te { text-anchor: end; }

    .output-content {
        <% output_content_styles.each do | key, value | %>
        <%= key %>: <%= value %>;
        <% end %>
    }

    <%# 表紙テンプレート (format-front) 用の文字サイズクラス %>
    .s1 { font-size: 12.17px; }
    .s2 { font-size: 17.29px; }
    .s3 { font-size: 12.98px; }
    .s4 { font-size: 9.93px; }
    .s5 { font-size: 10.99px; }
    .s6 { font-size: 10.82px; }
    .s7 { font-size: 12.98px; }
    .s8 { font-size: 19.44px; }
    .s9 { font-size: 17.29px; text-transform: full-width; }
    .sa { font-size: 15.13px; }
    .sb { font-size: 21.64px; }
    .sc { font-size: 25.96px; }
    .sd { font-size: 15.13px; }
    .se { font-size: 16.44px; }
    .sf { font-size: 14.71px; }
    .sg { font-size: 11.58px; }
    .sh { font-size: 14.25px; }
    .si { font-size: 14.25px; }

    <%# 罫線パスの共通スタイル。fill/stroke/stroke-miterlimit は全線種で共通のため一括指定 %>
    .g0 { fill: #FFF; }
    .g1, .g2, .g3, .g4, .g5 { fill: none; stroke: #000; stroke-miterlimit: 10; }
    .g1 { stroke-width: 0.274; }                         <%# 通常の実線 %>
    .g2 { stroke-width: 0.274; stroke-dasharray: 2,2; }  <%# 破線（摘要欄の仕切り等） %>
    .g3 { stroke-width: 1.731; }                         <%# 太実線 %>
    .g4 { stroke-width: 2.597; }                         <%# 極太実線 %>
    .g5 { fill: #FFF; stroke-width: 0.274; }             <%# 白塗り + 実線 %>

    <%# 続紙テンプレート (format-next) 用のクラス。元々 SVG 内 <style> に記述されていたものを外部化 %>
    .s1_2 { font-size: 17.31px; }
    .s2_2 { font-size: 12.99px; }
    .s4_2 { font-size: 13.20px; }
    .s5_2 { font-size: 17.60px; }
    .s7_2 { font-size: 16.13px; }
    .s8_2 { font-size: 13.93px; }
    .g0_2 { fill: #F0EDEB; }
    .g1_2 { fill: #FFFFFF; }


    @font-face {
        font-family: Mincho;
        src: local("BIZ UD明朝 Medium"),
            local("Hiragino Mincho ProN W3"),
            local("Hiragino Mincho ProN");
    }

    </style>
</body>
</html>
